{
  "name": "@luhanxin/spec-hub-rspress-plugin",
  "version": "0.0.0",
  "description": "rspress plugin that renders a synced @luhanxin/spec-hub-core RepoContent tree into a docs site",
  "keywords": [
    "openspec",
    "rspress",
    "rspress-plugin",
    "spec-hub"
  ],
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhx-space/lhx-spec-hub.git",
    "directory": "packages/rspress-plugin"
  },
  "homepage": "https://github.com/lhx-space/lhx-spec-hub/tree/main/packages/rspress-plugin#readme",
  "bugs": {
    "url": "https://github.com/lhx-space/lhx-spec-hub/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:build": "node scripts/verify-build.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@luhanxin/spec-hub-core": "workspace:*",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "rspress": "^1.0.0"
  },
  "devDependencies": {
    "@rspress/shared": "^1.47.2",
    "@types/node": "^26.2.0",
    "rspress": "^1.47.2",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
