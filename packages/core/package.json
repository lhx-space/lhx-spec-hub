{
  "name": "@luhanxin/spec-hub-core",
  "version": "0.0.0",
  "private": false,
  "description": "Framework-agnostic sync/normalization engine for aggregating OpenSpec content across repos.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhx-space/lhx-spec-hub.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lhx-space/lhx-spec-hub/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/lhx-space/lhx-spec-hub/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "vitest run",
    "verify:yjs-docs": "tsx scripts/verify-against-yjs-docs.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
