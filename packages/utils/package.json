{
  "name": "@app/utils",
  "version": "0.0.0",
  "private": false,
  "description": "Utilities for the . monorepo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "rslib build --watch",
    "build": "rslib build"
  },
  "dependencies": {
    "@app/core": "workspace:*"
  }
}
