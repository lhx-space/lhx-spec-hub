{
  "name": "lhx-spec-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Aggregate OpenSpec specs from many repos into one searchable rspress/vitepress docs site.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^22.11.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "dev": "pnpm -r --parallel --filter='./packages/*' run dev",
    "typecheck": "pnpm -r --filter='./packages/*' run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "@rslib/core": "^0.23.2"
  }
}
